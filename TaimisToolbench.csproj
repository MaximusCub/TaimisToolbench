  <!--
    ref/ is packaged by exactly one thing: the BuildBlishHUDModule target near
    the bottom of this file, which copies ref\** into $(OutDir)ref\ and zips it.

    There used to be a second mechanism here - twelve <Content Include="ref\...">
    items with CopyToOutputDirectory - and having two owners produced both of the
    failures you would predict. Every listed file was copied twice per build,
    including the 14.8MB vendor_offers.json. And the hand-maintained list drifted:
    ref/vendor_offer_exclusions.json was never added to it, yet shipped in every
    .bhm anyway, because the target's glob does not consult this list. Nothing
    read the list to decide what ships, so nothing noticed it was wrong.

    To add a file to the shipped module, put it in ref/. To keep one out, add it
    to that target's Exclude. There is no third place to look.
  -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>NuGet packages have not been restored: {0} is missing. Run this from the repository root, then build again: nuget restore TaimisToolbench.sln -- note that dotnet restore does NOT restore a packages.config project and will report Nothing to do instead. Get nuget.exe from https://www.nuget.org/downloads (see CONTRIBUTING.md, Prerequisites).</ErrorText>
    </PropertyGroup>
    <!-- Checked before the restore errors below, because a version bump and a
         missing restore look identical to an Exists() test on a version-pinned
         path, and only one of them is fixed by running nuget restore. -->
    <ItemGroup>
      <RestoredBlishHudTargets Include="packages\BlishHUD.*\build\BlishHUD.targets" />
    </ItemGroup>
    <Error Condition="'@(RestoredBlishHudTargets)' != '' AND !Exists('packages\BlishHUD.1.3.0\build\BlishHUD.targets')" Text="This project carries a hand-maintained fork of BlishHUD 1.3.0's BuildBlishHUDModule target (see the comment above that target), but the restored package is '@(RestoredBlishHudTargets)'. The fork wins over whatever the new package imports, so the build would silently keep 1.3.0's packaging behaviour. Re-fork the target from the new version's BlishHUD.targets, re-apply the ref/ Exclude, then update the version in this check and in the Import below." />
    <Error Condition="!Exists('packages\BlishHUD.1.3.0\build\BlishHUD.targets')" Text="$([System.String]::Format('$(ErrorText)', 'packages\BlishHUD.1.3.0\build\BlishHUD.targets'))" />
    <Error Condition="!Exists('packages\MonoGame.Framework.WindowsDX.3.8.0.1641\build\MonoGame.Framework.WindowsDX.targets')" Text="$([System.String]::Format('$(ErrorText)', 'packages\MonoGame.Framework.WindowsDX.3.8.0.1641\build\MonoGame.Framework.WindowsDX.targets'))" />
  </Target>
  <Import Project="packages\BlishHUD.1.3.0\build\BlishHUD.targets" Condition="Exists('packages\BlishHUD.1.3.0\build\BlishHUD.targets')" />
  <!--
    Override of BuildBlishHUDModule from the imported BlishHUD.targets above.
    packages\ is NuGet-restored and gitignored, so it cannot carry a real fix;
    this redefinition (same name, declared after the import, so it wins) is
    a VERBATIM FORK of BlishHUD 1.3.0's target, character for character, except
    that the RefFiles Include gains an Exclude. See docs/RELEASING.md.

    Excluded, and why each earns it - all six are inputs to or run state of the
    offline tools under tools/, none has a runtime consumer anywhere in
    Services/, Views/ or Models/, so none of them belongs in a player's
    download:
      wiki_vendor_cache.json, item_id_cache.json  VendorOfferUpdater caches
      seasonal_wikitext_cache.json                VendorOfferUpdater cache
      vendor_offers_unresolved.json               VendorOfferUpdater sidecar
      mf_item_id_cache.json                       MysticForgeSeeder cache
      vendor_offer_exclusions.json                VendorOfferUpdater input
    All but the last are gitignored; vendor_offer_exclusions.json is tracked,
    because it is hand-verified data the refresh tool needs, not a regenerable
    cache. Tracked or not makes no difference here - this Exclude is what
    decides what ships, and .gitignore only decides what git stores. Adding a
    ref/ line to .gitignore is therefore only half the job; the file also has
    to be named here, and nothing yet fails a build that forgets.

    BEING A FORK IS THE HAZARD. It is pinned to 1.3.0 by hand and cannot notice
    an upstream change: bump the BlishHUD package and this file keeps packaging
    the 1.3.0 way, winning over the target the new version imports, in silence.
    The EnsureNuGetPackageBuildImports target above fails the build with that
    exact explanation if a BlishHUD other than 1.3.0 is ever restored.
  -->
  <Target Name="BuildBlishHUDModule" AfterTargets="Build">
    <!-- Remove existing bhm file -->
    <Delete Files="$(BlishHUDModuleFilePath)" />

    <!-- Copy manifest.json -->
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(OutDir)" />

    <!-- Copy ref files -->
    <ItemGroup>
      <RefFiles Include="$(ProjectDir)ref\**" Exclude="$(ProjectDir)ref\wiki_vendor_cache.json;$(ProjectDir)ref\item_id_cache.json;$(ProjectDir)ref\seasonal_wikitext_cache.json;$(ProjectDir)ref\vendor_offers_unresolved.json;$(ProjectDir)ref\mf_item_id_cache.json;$(ProjectDir)ref\vendor_offer_exclusions.json" />
    </ItemGroup>
    <Copy SourceFiles="@(RefFiles)" DestinationFolder="$(OutDir)ref\%(RecursiveDir)" />

    <!-- Copy the whole output dir to a temporary subfolder so we can zip it without issues -->
    <ItemGroup>
      <OutFiles Include="$(OutDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(OutFiles)" DestinationFolder="$(BlishHUDModuleTempPath)\%(RecursiveDir)" />

    <!-- Zip subfolder -->
    <ZipDirectory SourceDirectory="$(BlishHUDModuleTempPath)" DestinationFile="$(BlishHUDModuleFilePath)" Overwrite="true" />

    <!-- Remove the temporary subfolder -->
    <RemoveDir Directories="$(BlishHUDModuleTempPath)" />
  </Target>
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties manifest_1json__JsonSchema="" />
    </VisualStudio>
  </ProjectExtensions>
  <Import Project="packages\MonoGame.Framework.WindowsDX.3.8.0.1641\build\MonoGame.Framework.WindowsDX.targets" Condition="Exists('packages\MonoGame.Framework.WindowsDX.3.8.0.1641\build\MonoGame.Framework.WindowsDX.targets')" />
</Project>